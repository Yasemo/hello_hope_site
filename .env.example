# Copy to .env for local development. Do not commit real values.
# Production values are set on the Cloud Run service, not in this file.

PORT=8000

# EmailJS (contact form + schedule builder)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_SCHEDULE_TEMPLATE_ID=

# Airtable (shop catalog)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# PayPal (merch checkout). Use "live" or "sandbox"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Admin CMS at /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Meta Pixel / Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Luma conference ticket webhook
LUMA_WEBHOOK_SECRET=

# Unused leftovers. Safe to leave empty.
SMTP_USERNAME=
SMTP_PASSWORD=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
